---
interface Props {
  href?: string;
  size?: "md" | "lg" | "xl";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href = "/",
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  md: "px-4 py-2",
  lg: "px-5 py-2.5",
  xl: "px-12 py-5",
};

const styles = {
  outline: "bg-white border-2 border-ink hover:bg-gray-100 text-ink ",
  green: "bg-green text-white hover:bg-green/85 border-2 border-transparent",
  primary: "bg-ink text-white hover:bg-gray-700  border-2 border-transparent",
  inverted: "bg-white text-ink   border-2 border-transparent",
  muted: "bg-gray-100 hover:bg-gray-200   border-2 border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    "rounded-none text-center font-medium transition focus-visible:ring-2 ring-offset-2 ring-gray-200",
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
