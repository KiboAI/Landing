const splitPhrase = (t) => {
  const m = t.match(/^(\p{Extended_Pictographic}\uFE0F?)/u);
  return m ? { emoji: m[1], rest: t.slice(m[1].length) } : { emoji: "", rest: t };
};
const marqueeRows = rows.map((row) => [...row, ...row].map(splitPhrase));
const OFFSETS = [0, -400, -800, -1200, -1600];
---

<div class="marquee" aria-hidden="true">
  {marqueeRows.map((row, i) => (
    <div class="marquee-row" style={`margin-left: ${OFFSETS[i]}px`}>
      {row.map((p) => (
        <span class="phrase">
          {p.emoji !== "" && <span class="phrase-emoji">{p.emoji}</span>}
          <span class="phrase-text">{p.rest}</span>
        </span>
      ))}
    </div>
  ))}
</div>

<style>
  .marquee {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vw, 29px);
    overflow: hidden;
  }
  .marquee-row {
    display: flex;
    width: max-content;
    white-space: nowrap;
    font-size: clamp(28px, 3.8vw, 60px);
    font-weight: 500;
    line-height: 1.5;
    color: #000000;
    animation: marquee linear infinite;
    will-change: transform;
  }
  .marquee-row .phrase { margin-right: 4px; }
  .marquee-row .phrase-emoji {
    -webkit-text-fill-color: initial;
    color: initial;
  }
  .marquee-row .phrase-text {
    background: linear-gradient(to right, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.25));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
</style>

<script>
  const MARQUEE_SPEEDS = [45, 51.4, 45, 51.4, 45]; // 0.75 倍速
  function setMarqueeSpeed() {
    document.querySelectorAll(".marquee-row").forEach((row, i) => {
      const width = row.scrollWidth;
      row.style.animationDuration = width / 2 / MARQUEE_SPEEDS[i] + "s";
    });
  }
  setMarqueeSpeed();
  window.addEventListener("resize", setMarqueeSpeed);
</script>
