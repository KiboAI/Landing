---
import Container from "@/components/container.astro";
---

<footer class="bg-ink">
  <Container>
    <div class="footer-layout">

      <div class="footer-slogan">
        <h2 class="font-semibold text-white">让 Kibo 伴你左右</h2>
        <p class="font-semibold text-secondary">很多 AI 帮你学习语言，Kibo 帮你完成交流</p>
      </div>


      <div class="footer-menus">
        <div>
          <h4 class="text-sm font-medium text-secondary">产品</h4>
          <a href="/" class="noop block mt-2.5 text-sm font-medium text-white">网页版</a>
          <a href="/" class="noop block mt-2.5 text-sm font-medium text-white">App</a>
        </div>
        <div>
          <h4 class="text-sm font-medium text-secondary">资源</h4>
          <a href="/" class="noop block mt-2.5 text-sm font-medium text-white">文档</a>
          <a href="/" class="noop block mt-2.5 text-sm font-medium text-white">动态</a>
        </div>
        <div>
          <h4 class="text-sm font-medium text-secondary">更多</h4>
          <a href="https://github.com/KiboAI" target="_blank" rel="noopener" class="block mt-2.5 text-sm font-medium text-white">GitHub</a>
          <a href="mailto:support@kibotalk.app" class="block mt-2.5 text-sm font-medium text-white">联系</a>
        </div>
      </div>


      <div class="footer-qr">
        <img src="/assets/images/qr-wechat.png" alt="加入产品内测群二维码" class="w-[100px] h-[100px]" width="100" height="100" />
        <span class="block mt-2.5 text-sm font-medium text-white">加入产品内测群</span>
      </div>


      <div class="footer-brand">
        <img src="/assets/logo/logo-white.svg" alt="KiboTalk" class="h-4 w-auto" width="97" height="16" />
        <p class="mt-3 text-sm text-secondary">©2026 KiboAI</p>
      </div>
    </div>
  </Container>
</footer>
